{
    "name": "php-nil/kernel",
    "description": "Nil Kernel - A lightweight PHP kernel built on Symfony components",
    "keywords": ["nil", "kernel", "framework", "symfony"],
    "license": "MIT",
    "require": {
        "php": ">=8.4.0",
        "symfony/error-handler": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/console": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/contracts": "^3.6",
        "doctrine/dbal": "^4.4",
        "monolog/monolog": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Nil\\Kernel\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
